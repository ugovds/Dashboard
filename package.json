{
  "name": "violet-cockpit",
  "version": "5.2.0",
  "description": "Violet Cockpit - Bureau Electron Moderne & Startpage",
  "author": "ugovds <ugo.vds@gmail.com>",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node electron/dev.js",
    "build": "vite build",
    "build:app": "vite build && electron-builder",
    "pack": "vite build && electron-builder --dir",
    "dist:linux": "vite build && electron-builder --linux",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.violet.cockpit",
    "productName": "Violet Cockpit",
    "directories": {
      "output": "release"
    },
    "files": [
      {
        "from": "dist",
        "to": "dist",
        "filter": ["**/*"]
      },
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons/icon.png",
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Violet Cockpit",
      "uninstallDisplayName": "Violet Cockpit",
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "ugovds",
      "repo": "Dashboard"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icons/icon.png",
      "category": "public.app-category.utilities"
    }
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.7.0",
    "vite": "^6.0.0"
  }
}
